# Copy to .env.local. Never commit real values.

# Public URL of THIS admin app (used in invite emails). Local: http://localhost:3100
ADMIN_URL=http://localhost:3100

# Same MongoDB database as the public website, but use a DEDICATED database user for this app
# (read/write on admin* collections, read on donations/volunteers/messages). See SECURITY.md.
MONGODB_URI=mongodb+srv://ADMIN_APP_USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=obijiaku

# At least 32 random characters. Generate: openssl rand -base64 48
# Used to sign login codes and encrypt authenticator secrets. Changing it logs everyone out
# and disables every authenticator app enrolment.
AUTH_SECRET=

# Resend: sign-in codes and invitations
RESEND_API_KEY=
MAIL_FROM=Obijiaku Admin <admin@your-domain.org>

# Set to "off" only in automated tests (skips the breached-password check)
HIBP_CHECK=on
